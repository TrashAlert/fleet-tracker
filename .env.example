APP_NAME="Fleet Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fleet_tracker
DB_USERNAME=root
DB_PASSWORD=

# Session (idle timeout in minutes — drives the inactivity auto-logout)
SESSION_DRIVER=file
SESSION_LIFETIME=60

# MQTT Broker Configuration
# Key names MUST match config/mqtt-client.php exactly (MQTT_AUTH_* / MQTT_TLS_*).
MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_AUTH_USERNAME=fleet_server
MQTT_AUTH_PASSWORD=
MQTT_TOPIC_PREFIX=fleet/

# TLS — the broker listens TLS-only on 8883; auth is username/password (no client cert).
MQTT_TLS_ENABLED=true
MQTT_TLS_CA_FILE=/etc/mosquitto/certs/ca.crt
MQTT_TLS_ALLOW_SELF_SIGNED_CERT=true
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_VERIFY_PEER_NAME=false

# Subscriber resilience + presence beacon (see config/mqtt-client.php).
# Auto-reconnect requires a persistent session (use_clean_session=false, the default).
MQTT_AUTO_RECONNECT=true
MQTT_STATUS_TOPIC=fleet/system/subscriber/status

# Mail (for delay notifications)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@fleettracker.local"
MAIL_FROM_NAME="${APP_NAME}"

# GPS Settings
GPS_OVERSPEED_THRESHOLD=110
GPS_DELAY_THRESHOLD_MINUTES=15
GPS_STALE_TIMEOUT_SECONDS=60
